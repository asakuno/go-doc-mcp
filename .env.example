# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vectordb

# Embedding Provider Configuration
# Options: "ollama" (free, local) or "openai" (paid, cloud)
EMBEDDING_PROVIDER=ollama

# Ollama Configuration (for free local embeddings)
OLLAMA_URL=http://localhost:11434
# Recommended models: nomic-embed-text (768 dims), mxbai-embed-large (1024 dims)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# OpenAI Configuration (optional, only if using EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Document Configuration
DOCUMENT_PATH=/path/to/your/documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
